{
  "name": "rank-engine",
  "version": "1.0.0",
  "description": "Rank Companion — JEE Main Rank Predictor with Capacitor Mobile Support",
  "private": true,
  "author": "Praveenepili13",
  "license": "MIT",
  "scripts": {
    "prepare-web": "node ./scripts/copy-web.js",
    "cap:init": "npx cap init \"Rank Companion\" com.praveenepili13.rankcompanion --web-dir=www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "dev": "npx live-server --port=8080 www/",
    "build": "echo 'Build complete - serve from www/ directory'"
  },
  "dependencies": {
    "@capacitor/core": "^5.7.0",
    "@capacitor/haptics": "^5.7.0",
    "@capacitor/status-bar": "^5.7.0",
    "@capacitor/keyboard": "^5.7.0",
    "@capacitor/toast": "^5.7.0",
    "@capacitor/preferences": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0"
  }
}
